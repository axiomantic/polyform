#!/usr/bin/env python3
"""Regenerate Nim bindings using HeaderKit from C/C++ headers."""

from pathlib import Path
import subprocess
import sys


def main() -> int:
    repo_root = Path(__file__).parent.parent
    config_path = repo_root / "headerkit.toml"
    bindings_dir = repo_root / "src" / "{{ package_name }}"
    bindings_dir.mkdir(parents=True, exist_ok=True)
    out_path = bindings_dir / "bindings.nim"

    print(f"Generating Nim bindings via {config_path} -> {out_path}...")
    cmd = [
        "headerkit",
        "generate",
    ]
    try:
        subprocess.run(cmd, cwd=str(repo_root), check=True)
        print("Bindings successfully generated.")
        return 0
    except FileNotFoundError:
        print("Error: 'headerkit' CLI not found. Install via 'pip install headerkit'.", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print(f"Error during binding generation: {e}", file=sys.stderr)
        return e.returncode


if __name__ == "__main__":
    sys.exit(main())

