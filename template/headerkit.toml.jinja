# HeaderKit v2 Declarative Schema for {{ package_name }}

backend = "libclang"
headers = ["include/{{ package_name }}.h"]
include_dirs = ["include"]

[[targets]]
name = "{{ package_name }}_bindings"
writer = "nim"
output = "src/{{ package_name }}/bindings.nim"
{%- if has_embedded %}
options = { embedded = true }
{%- endif %}

