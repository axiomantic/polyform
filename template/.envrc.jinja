# .envrc - Direnv development environment configuration
# Generated by Polyform: tailored to active language facets and build caches.

export PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/dev-workspaces/{{ repo_name }}"
mkdir -p "$CACHE_ROOT"

# Load local uncommitted developer environment variables and overrides
dotenv_if_exists .env.local
source_env_if_exists .envrc.local
{% if has_nim %}

# Nim build cache isolation & bin PATH
export NIMCACHE="$CACHE_ROOT/nimcache"
PATH_add "$PROJECT_ROOT/bin"
{%- endif %}
{%- if has_c_cpp or has_nim %}

# Compiler caching across workspaces
if command -v ccache >/dev/null 2>&1; then
    export CCACHE_BASEDIR="$(dirname "$PROJECT_ROOT")"
    export CCACHE_NOHASHDIR=1
fi
{%- endif %}
{%- if has_python %}

# Python uv fast-clone mode and virtual environment activation
export UV_LINK_MODE="clone"
if [ -d "$PROJECT_ROOT/.venv/bin" ]; then
    VIRTUAL_ENV="$PROJECT_ROOT/.venv"
    export VIRTUAL_ENV
    PATH_add "$VIRTUAL_ENV/bin"
fi
{%- endif %}
{%- if has_typescript %}

# TypeScript / Node dependencies PATH
PATH_add "$PROJECT_ROOT/node_modules/.bin"
{%- endif %}
