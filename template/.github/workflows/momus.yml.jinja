name: Momus

on:
  pull_request:
    types: [opened]
  issue_comment:
    types: [created]
  workflow_dispatch:
    inputs:
      pr_number:
        description: PR number to review
        required: true
        type: string

permissions: {}

concurrency:
  group: momus-{% raw %}${{ github.event.pull_request.number || github.event.issue.number || github.event.inputs.pr_number || github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
  call:
    if: >-
      github.event.sender.type != 'Bot' && (
        github.event_name == 'workflow_dispatch' ||
        (github.event_name == 'pull_request' && github.event.action == 'opened') ||
        (
          github.event_name == 'issue_comment' &&
          github.event.issue.pull_request != null &&
          (
            startsWith(github.event.comment.body, '/ai-review') ||
            contains(github.event.comment.body, '@axiomantic-momus[bot]')
          )
        )
      )
    permissions:
      contents: read
      pull-requests: write
      issues: write
    uses: axiomantic/.github/.github/workflows/momus.yml@devel
    with:
      pr_number: {% raw %}${{ github.event.pull_request.number || github.event.issue.number || github.event.inputs.pr_number }}{% endraw %}
      event_name: {% raw %}${{ github.event_name }}{% endraw %}
      trigger_command: /ai-review
      trigger_mention: "@axiomantic-momus[bot]"
      model: {{ momus_model }}
      base_url: {{ momus_base_url }}
      only_collaborators: true
      environment: code-review
    secrets:
      LLM_API_KEY: {% raw %}${{ secrets.LLM_API_KEY }}{% endraw %}
      MOMUS_APP_ID: {% raw %}${{ secrets.MOMUS_APP_ID }}{% endraw %}
      MOMUS_APP_PRIVATE_KEY: {% raw %}${{ secrets.MOMUS_APP_PRIVATE_KEY }}{% endraw %}
