version: 2
enable-beta-ecosystems: true

updates:
  # GitHub Actions workflow updates
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- if flavor == 'nim_ts_wasm' %}

  # npm ecosystem for TypeScript / WASM bridge
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- elif flavor == 'nim_python_wheel' %}

  # pip ecosystem for Python wheel dependencies
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- endif %}
{%- if docs_engine == 'starlight' %}

  # npm ecosystem for docs portal
  - package-ecosystem: "npm"
    directory: "/docs"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- endif %}
