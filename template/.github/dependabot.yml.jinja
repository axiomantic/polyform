version: 2
enable-beta-ecosystems: true

updates:
  # GitHub Actions workflow updates
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- if has_typescript %}

  # npm ecosystem for TypeScript packages
  - package-ecosystem: "npm"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- endif %}
{%- if has_python %}

  # pip ecosystem for Python dependencies
  - package-ecosystem: "pip"
    directory: "/"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- endif %}
{%- if docs_engine == 'starlight' %}

  # npm ecosystem for docs portal
  - package-ecosystem: "npm"
    directory: "/docs"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
{%- endif %}
