import? 'justfile.local'

default:
    @just --list

# 1. Dependency Setup
setup:
{%- if has_typescript %}
    npm install
{%- endif %}
{%- if has_python %}
    python3 -m pip install -e ".[dev]"
{%- endif %}
{%- if has_nim %}
    nimble install --depsOnly -y
{%- endif %}
{%- if docs_engine == 'starlight' %}
    cd docs && npm install
{%- endif %}

# 2. Test Suite Execution
test:
{%- if has_nim %}
    nimble test
{%- endif %}
{%- if has_typescript %}
    npm run test
{%- endif %}
{%- if has_python %}
    pytest tests_py/
{%- endif %}

# 3. Linter Execution
lint:
{%- if has_nim %}
    nph --check .
    nimble check
{%- endif %}
{%- if has_typescript %}
    npm run lint
{%- endif %}
{%- if has_python %}
    ruff check .
{%- endif %}

# 4. Formatter Execution
fmt:
{%- if has_nim %}
    nph .
{%- endif %}
{%- if has_typescript %}
    npm run fmt
{%- endif %}
{%- if has_python %}
    ruff format .
{%- endif %}

# 5. Build Artifacts
build:
{%- if has_typescript and (ts_bridge_strategy | default('none')) == 'wasm' %}
    npm run build
{%- elif has_python and (python_bridge_strategy | default('none')) == 'ctypes_cabi' %}
    python -m build --wheel
{%- elif has_nim %}
    nimble build -d:release
{%- else %}
    @echo "No build target configured for active facets"
{%- endif %}

{%- if docs_engine == 'starlight' %}

# 6. Documentation Dev Server
docs:
    nimble docgen
    cd docs && npm run dev

# 7. Documentation Production Build
docs-build:
    nimble docgen
    cd docs && npm run build
{%- endif %}

# 8. Clean Build Artifacts
clean:
    rm -rf nimcache htmldocs site docs/dist docs/.astro tools/docgen
    find . -name '*.exe' -delete

# 9. Secret Scanning
check-secrets:
    @if command -v gitleaks >/dev/null 2>&1; then \
        gitleaks detect -v; \
    elif command -v pre-commit >/dev/null 2>&1; then \
        pre-commit run gitleaks --all-files; \
    else \
        echo "Error: neither gitleaks nor pre-commit found. Install gitleaks or pre-commit." >&2; exit 1; \
    fi

# 10. Upstream Template Synchronization
update-template:
    uvx copier update --trust
