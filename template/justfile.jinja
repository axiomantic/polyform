import? 'justfile.local'

default:
    @just --list

# 1. Dependency Setup
setup:
{%- if has_typescript %}
    npm install
{%- endif %}
{%- if has_nim %}
    nimble install --depsOnly -y
{%- endif %}
{%- if has_python %}
    python3 -m pip install -e ".[dev]"
{%- endif %}
{%- if has_nim and has_c_cpp and (c_binding_strategy | default('none')) == 'headerkit' %}
    python3 -m pip install "headerkit>=0.51.0"
{%- elif has_c_cpp and (c_binding_strategy | default('none')) == 'headerkit' %}
    python3 -m pip install pyyaml
{%- endif %}
{%- if docs_engine == 'starlight' %}
    cd docs && npm install --legacy-peer-deps
{%- endif %}

# 2. Test Suite Execution
test:
{%- if has_nim %}
    @just test-nim
{%- endif %}
{%- if has_python %}
    @just test-py
{%- endif %}
{%- if has_typescript %}
    @just test-ts
{%- endif %}

{%- if has_nim %}

test-nim:
    nimble test
    @find tests -maxdepth 1 -type f -perm +111 ! -name "*.*" -delete 2>/dev/null || true
{%- endif %}
{%- if has_python %}

test-py:
    uv run --with pytest pytest tests_py
{%- endif %}
{%- if has_typescript %}

test-ts:
{%- if has_nim and (ts_bridge_strategy | default('none')) == 'wasm' %}
    @just compile-wasm
{%- endif %}
    npx vitest run
{%- endif %}
{%- if ci_gpu_runner == 'krun_apple_silicon' %}

# Run GPU-accelerated tests
test-gpu:
{%- if has_nim %}
    @if [ -f tests/test_gpu.nim ]; then \
        nim c -r -d:danger --mm:orc tests/test_gpu.nim; \
    elif [ -f tests/t_gpu.nim ]; then \
        nim c -r -d:danger --mm:orc tests/t_gpu.nim; \
    else \
        echo "No dedicated GPU test suite found (tests/test_gpu.nim or tests/t_gpu.nim)."; \
    fi
{%- elif has_python %}
    uv run --with pytest pytest -m gpu tests_py || uv run --with pytest pytest tests_py
{%- else %}
    @echo "No GPU test runner defined for current facets."
{%- endif %}
{%- endif %}

# 3. Linter Execution
lint:
{%- if has_nim %}
    @just lint-nim
{%- endif %}
{%- if has_python %}
    @just lint-py
{%- endif %}
{%- if has_typescript %}
    @just lint-ts
{%- endif %}

{%- if has_nim %}

lint-nim:
    nph --check .
    nimble check
{%- if nimony_ci | default(true) %}

# Nimony (Nim 3.0 preview) strict compatibility check
check-nimony:
    @if command -v nimony >/dev/null 2>&1; then \
        nimony check src/{{ package_name }}.nim; \
    else \
        nim check --experimental:strictFuncs --experimental:strictDefs src/{{ package_name }}.nim; \
    fi
{%- endif %}
{%- endif %}
{%- if has_python %}

lint-py:
    uv run --with ruff ruff check .
{%- endif %}
{%- if has_typescript %}

lint-ts:
    npm run lint
{%- endif %}

# 4. Formatter Execution
fmt:
{%- if has_nim %}
    nph .
{%- endif %}
{%- if has_typescript %}
    npm run fmt
{%- endif %}
{%- if has_python %}
    uv run --with ruff ruff format .
{%- endif %}

# 5. Build Artifacts
build:
{%- if has_nim and has_typescript and (ts_bridge_strategy | default('none')) == 'wasm' %}
    @just compile-wasm
    npm run build
{%- elif has_nim and has_python and (python_bridge_strategy | default('none')) in ['ctypes_cabi', 'naganim'] %}
    @just build-wheel
{%- elif has_nim and has_c_cpp and (c_binding_strategy | default('none')) == 'headerkit' %}
    @just gen-bindings
    nimble build -d:release
{%- elif has_nim %}
    nimble build -d:release
{%- elif has_typescript %}
    npm run build
{%- elif has_python %}
    python3 -m build --wheel
{%- endif %}

{%- if has_nim and has_typescript and (ts_bridge_strategy | default('none')) == 'wasm' %}

# Compile Nim to WebAssembly
compile-wasm:
    bash scripts/compile_wasm.sh
{%- endif %}
{%- if has_nim and has_python %}

# Build native Python extension wheel
build-wheel:
    python3 -m build --wheel
{%- endif %}
{%- if has_nim and has_c_cpp and (c_binding_strategy | default('none')) == 'headerkit' %}

# Generate HeaderKit foreign C bindings
gen-bindings:
    headerkit generate || python3 scripts/generate_bindings.py
{%- endif %}

{%- if docs_engine == 'starlight' %}

# 6. Documentation Dev Server
docs:
{%- if has_nim %}
    nimble docgen
{%- endif %}
    cd docs && npm run dev

# 7. Documentation Production Build
docs-build:
{%- if has_nim %}
    nimble docgen
{%- endif %}
    cd docs && npm run build
{%- endif %}

# 8. Clean Build Artifacts
clean:
    rm -rf nimcache htmldocs site docs/dist docs/.astro tools/docgen dist .venv
    find . -name '*.exe' -delete
    find tests -maxdepth 1 -type f -perm +111 ! -name "*.*" -delete 2>/dev/null || true

# Clean local build and test nimcaches
clean-cache:
    rm -rf nimcache

# 9. Secret Scanning
check-secrets:
    @if command -v gitleaks >/dev/null 2>&1; then \
        gitleaks detect -v; \
    elif command -v pre-commit >/dev/null 2>&1; then \
        pre-commit run gitleaks --all-files; \
    else \
        echo "Error: neither gitleaks nor pre-commit found. Install gitleaks or pre-commit." >&2; exit 1; \
    fi

# 10. Repository Security & Branch Protection
protect-repo:
    python3 scripts/protect_repo.py

check-protection:
    python3 scripts/protect_repo.py --check

# 11. Upstream Template Synchronization
update-template:
    uvx copier update --trust
