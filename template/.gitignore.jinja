# Default: ignore all dotfiles and dotdirectories
.*

# Explicit dotfile opt-ins (tracked template standards)
!.gitignore
!.editorconfig
!.envrc
!.pre-commit-config.yaml
!.copier-answers.yml
!.github/
{% if enable_momus_review -%}
!.momus.yaml
{%- endif %}

# Swarm ceremony and transient files
garden.toml
garden-swarm.json
garden-prompts.md
implementation_plan.md
understanding.md
audit_report.md
adversarial_code_review_plan.md

# Build caches & binaries
nimcache/
*.exe
*.out
*.dll
*.so
*.dylib
nimblecache/
.nimble/
htmldocs/
site/
*.swp
justfile.local

{% if docs_engine != 'none' %}
# Documentation build artifacts
docs/node_modules/
docs/.astro/
docs/dist/
{% if docs_engine == 'starlight' %}
tools/docgen
{% endif %}
{% endif %}

{% if has_typescript %}
# TypeScript artifacts
node_modules/
dist/
{% if ts_bridge_strategy == 'wasm' %}
*.wasm
{% endif %}
{% endif %}
{% if has_python %}
# Python artifacts
__pycache__/
*.pyc
build/
*.egg-info/
{% endif %}
{% if has_c_cpp %}
# Foreign C/C++ artifacts
*.o
*.a
build/
{% endif %}
