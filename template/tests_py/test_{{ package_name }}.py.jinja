import pytest
from {{ package_name }} import add, hello, version


def test_hello() -> None:
    greeting = hello()
    assert greeting == "hello from {{ package_name }}"


def test_version() -> None:
    v = version()
    assert v == "0.0.1"


def test_add_positive_numbers() -> None:
    result = add(10, 25)
    assert result == 35


def test_add_negative_and_zero() -> None:
    assert add(-5, 5) == 0
    assert add(0, 0) == 0
    assert add(-10, -20) == -30


def test_add_type_contract() -> None:
    # Negative control: invalid argument types should raise TypeError or fail conversion
    with pytest.raises((TypeError, ValueError)):
        add("invalid", 10)  # type: ignore[arg-type]
{%- if has_nim and (python_bridge_strategy | default('none')) == 'phyne' %}


def test_phyne_bridge_loader_contract(monkeypatch: pytest.MonkeyPatch) -> None:
    import importlib
    import sys
    import types

    import {{ package_name }} as pkg

    assert pkg.BRIDGE_STRATEGY == "phyne"
    recorded: dict[str, str] = {}

    class _MockLib:
        def nim_init(self) -> None:
            recorded["init"] = "called"

        def nim_hello(self) -> bytes:
            return b"hello from {{ package_name }}"

        def nim_add(self, a: int, b: int) -> int:
            return a + b

        def nim_version(self) -> bytes:
            return b"0.0.1"

    mock_phyne = types.ModuleType("phyne")

    def _load_cffi_library(path: str, cdef: str) -> _MockLib:
        recorded["path"] = path
        recorded["cdef"] = cdef
        return _MockLib()

    mock_phyne.load_cffi_library = _load_cffi_library  # type: ignore[attr-defined]
    monkeypatch.setitem(sys.modules, "phyne", mock_phyne)
    importlib.reload(pkg)
    assert recorded["path"] == str(pkg._lib_path)
    assert "void nim_init(void);" in recorded["cdef"]
    assert "int32_t {{ package_name }}_add(int32_t a, int32_t b);" in recorded["cdef"]
    assert recorded["init"] == "called"
    assert pkg.add(7, 8) == 15

    monkeypatch.delitem(sys.modules, "phyne", raising=False)
    importlib.reload(pkg)
{%- endif %}
