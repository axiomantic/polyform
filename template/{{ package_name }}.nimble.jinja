import std/[os, strutils]

# Package

version = "0.0.1"
author = "{{ author_name }}"
description = "{{ description }}"
license = "{{ license }}"
srcDir = "src"
installExt = @["nim"]

# Dependencies

requires "nim >= 2.0.0"

# Bounded test runner
#
# std/unittest has no per-test timeout, so every suite runs under a wall-clock
# bound enforced here. Compilation is unbounded; execution is wrapped in GNU
# `timeout --kill-after=10 <secs>` with stdin redirected from the null device so
# a suite can never block on a TTY read. Override the budget with
# `{{ package_name | upper }}_TEST_TIMEOUT=<secs>`; `=0` disables the bound for
# local debugging only.

const
  DefaultSuiteTimeoutSec = 300
  TimeoutEnvVar = "{{ package_name | upper }}_TEST_TIMEOUT"

proc suiteTimeoutSec(default: int): int =
  if not existsEnv(TimeoutEnvVar):
    return default
  let raw = getEnv(TimeoutEnvVar).strip()
  try:
    result = parseInt(raw)
  except ValueError:
    quit("ERROR: " & TimeoutEnvVar & "='" & raw & "' is not an integer", 1)
  if result < 0:
    quit("ERROR: " & TimeoutEnvVar & " must be >= 0 (got " & raw & ")", 1)

proc timeoutExe(): string =
  ## Resolve a GNU-compatible `timeout`; fail fast rather than run unbounded.
  for candidate in ["gtimeout", "timeout"]:
    let exe = findExe(candidate)
    if exe.len > 0 and gorgeEx(quoteShell(exe) & " --version").exitCode == 0:
      return exe
  quit(
    "ERROR: no GNU `timeout`/`gtimeout` on PATH; refusing to run test " &
      "suites unbounded (macOS: brew install coreutils; or set " & TimeoutEnvVar &
      "=0 to opt out for local debugging)",
    1,
  )

proc pruneTestBinaries() =
  ## Remove compiled test binaries without an extension left in tests/.
  for file in listFiles("tests"):
    let (_, _, ext) = splitFile(file)
    if ext.len == 0 and file.fileExists:
      try:
        rmFile(file)
      except OSError:
        discard

proc runSuite(file: string, timeoutSec = DefaultSuiteTimeoutSec) =
  ## Compile `file`, then execute it under a wall-clock bound. The compiled
  ## binary is removed afterwards whether the suite passes, fails, or times out.
  let
    secs = suiteTimeoutSec(timeoutSec)
    limiter =
      if secs == 0:
        ""
      else:
        timeoutExe()
    bin = thisDir() / "nimcache" / "bin" / splitFile(file).name & ExeExt
  when defined(windows):
    const devNull = "NUL"
  else:
    const devNull = "/dev/null"
  try:
    exec "nim c --hints:off -o:" & quoteShell(bin) & " " & quoteShell(file)
    if secs == 0:
      echo "WARNING: " & TimeoutEnvVar & "=0; running " & file & " unbounded"
      exec quoteShell(bin) & " < " & devNull
      return
    let bounded =
      quoteShell(limiter) & " --kill-after=10 " & $secs & " " & quoteShell(bin) & " < " &
      devNull
    when defined(windows):
      exec bounded
    else:
      # The report is assembled by printf so the literal marker never appears in
      # the command text that nimscript echoes on any non-zero exit.
      exec bounded & " || { rc=$?; if [ $rc -eq 124 ] || [ $rc -eq 137 ]; then " &
        "printf '%sOUT: %s exceeded %ss\\n' TIME " & quoteShell(file) & " " & $secs &
        " >&2; fi; exit $rc; }"
  finally:
    if fileExists(bin):
      rmFile(bin)

proc testSuites(): seq[string] =
  ## Nim convention: test modules are `tests/t*.nim` (e.g. `test_foo.nim`, `tfoo.nim`).
  for file in listFiles("tests"):
    let (_, name, ext) = splitFile(file)
    if ext == ".nim" and name.startsWith("t"):
      result.add file

# Tasks

task test, "Run test suite (each suite bounded by a wall-clock timeout)":
  try:
    for file in testSuites():
      runSuite(file)
  finally:
    pruneTestBinaries()
{%- if docs_engine == 'starlight' %}

task docgen, "Generate API documentation for Starlight":
  exec "nim c -r tools/docgen.nim"
{%- endif %}
