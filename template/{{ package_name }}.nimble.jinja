import std/os

# Package

version = "0.0.1"
author = "{{ author_name }}"
description = "{{ description }}"
license = "{{ license }}"
srcDir = "src"
installExt = @["nim"]

# Dependencies

requires "nim >= 2.0.0"

# Tasks

task test, "Run test suite":
  for file in listFiles("tests"):
    if (file.startsWith("tests/test") or file.startsWith("tests/t")) and
        file.endsWith(".nim") and not file.endsWith("config.nims"):
      exec "nim r --hints:off " & file
  # Auto-prune any compiled test binaries without extension left in tests/
  for file in listFiles("tests"):
    let (_, _, ext) = splitFile(file)
    if ext.len == 0 and file.fileExists:
      try:
        rmFile(file)
      except OSError:
        discard
{%- if docs_engine == 'starlight' %}

task docgen, "Generate API documentation for Starlight":
  exec "nim c -r tools/docgen.nim"
{%- endif %}
