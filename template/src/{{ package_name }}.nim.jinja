# {{ package_name }} - {{ description }}

const projectVersion* = "0.0.1"

const greetingMsg* = "hello from {{ package_name }}"

proc hello*(): string =
  ## Returns standard project greeting string.
  greetingMsg

{% if has_typescript and (ts_bridge_strategy | default('none')) == 'wasm' -%}
proc add*(a, b: int): int {.exportc: "add", cdecl.} =
  ## Adds two integers (exported to WebAssembly).
  a + b
{%- else -%}
proc add*(a, b: int): int =
  ## Adds two integers.
  a + b
{%- endif %}
{%- if has_c_cpp and (c_binding_strategy | default('none')) == 'headerkit' %}

# HeaderKit C-ABI foreign bindings
{.compile: "../include/{{ package_name }}.c".}

proc {{ package_name }}_add*(a, b: int32): int32 {.importc: "{{ package_name }}_add", cdecl.}
  ## Computes sum via foreign C entrypoint.
{%- endif %}
{%- if has_python and (python_bridge_strategy | default('none')) == 'ctypes_cabi' %}

# -----------------------------------------------------------------------------
# C-ABI Exports for Python ctypes / native extension
# -----------------------------------------------------------------------------

proc NimMain*() {.cdecl, importc.}

proc nim_init*() {.cdecl, exportc, dynlib.} =
  ## Explicit runtime initialization for C-ABI / ctypes loading.
  NimMain()

proc nim_hello*(): cstring {.cdecl, exportc, dynlib.} =
  ## Exported greeting proc returning static cstring buffer.
  greetingMsg.cstring

proc nim_add*(a, b: int): int {.cdecl, exportc, dynlib.} =
  ## Exported integer addition.
  add(a, b)

proc nim_version*(): cstring {.cdecl, exportc, dynlib.} =
  ## Exported version string.
  projectVersion.cstring
{%- endif %}
