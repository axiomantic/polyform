# {{ package_name }} - {{ description }}

const projectVersion* = "0.0.1"

const greetingMsg* = "hello from {{ package_name }}"

proc hello*(): string =
  ## Returns standard project greeting string.
  greetingMsg

{% if has_typescript and (ts_bridge_strategy | default('none')) == 'wasm' -%}
proc add*(a, b: int): int {.exportc: "add", cdecl.} =
  ## Adds two integers (exported to WebAssembly).
  a + b
{%- else -%}
proc add*(a, b: int): int =
  ## Adds two integers.
  a + b
{%- endif %}
{%- if has_c_cpp and (c_binding_strategy | default('none')) == 'headerkit' %}

# HeaderKit foreign bindings and high-level DSL re-exports
import ./{{ package_name }}/bindings
export bindings

import ./{{ package_name }}/dsl
export dsl
{%- endif %}
{%- if has_python and (python_bridge_strategy | default('none')) in ['ctypes_cabi', 'naganim'] %}

# -----------------------------------------------------------------------------
# C-ABI Exports for Python ({{ python_bridge_strategy | default('ctypes_cabi') }} bridge)
# -----------------------------------------------------------------------------
import std/atomics

const pythonBridgeStrategy* = "{{ python_bridge_strategy | default('ctypes_cabi') }}"

# 0 = uninitialized, 1 = initializing, 2 = initialized
var gNimMainState: Atomic[int]

proc NimMain*() {.cdecl, importc.}

proc nim_init*() {.cdecl, exportc, dynlib.} =
  ## Thread-safe idempotent runtime initialization with spin-wait barrier for
  ## free-threaded Python (PEP 703 nogil) and C-ABI / naganim loading.
  if gNimMainState.load(moAcquire) == 2:
    return
  var expected = 0
  if gNimMainState.compareExchange(expected, 1, moAcquireRelease, moAcquire):
    NimMain()
    gNimMainState.store(2, moRelease)
  else:
    while gNimMainState.load(moAcquire) != 2:
      cpuRelax()

proc nim_hello*(): cstring {.cdecl, exportc, dynlib.} =
  ## Exported greeting proc returning static cstring buffer.
  greetingMsg.cstring

proc nim_add*(a, b: int): int {.cdecl, exportc, dynlib.} =
  ## Exported integer addition.
  add(a, b)

proc nim_version*(): cstring {.cdecl, exportc, dynlib.} =
  ## Exported version string.
  projectVersion.cstring
{%- if (python_bridge_strategy | default('none')) == 'naganim' %}

proc nim_bridge_strategy*(): cstring {.cdecl, exportc, dynlib.} =
  ## Exported bridge strategy identifier for naganim runtime introspection.
  pythonBridgeStrategy.cstring
{%- endif %}
{%- endif %}
